# === Base de données ===
POSTGRES_PASSWORD=changeme_dev
DATABASE_URL=postgresql+asyncpg://tvp:changeme_dev@postgres:5432/tvp

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Sécurité / JWT ===
# Générer une vraie clé : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# === Application ===
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# === CORS ===
# Origines autorisees a appeler l'API depuis un navigateur.
# Plusieurs separees par des virgules. En PROD : l'URL du site,
# ex. CORS_ORIGINS=https://tousvospneus.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Fournisseur Maxityre / AD Tyres ===
MAXITYRE_BASE_URL=https://api.maxityre.com
MAXITYRE_SITE_ID=4
# Identifiants à renseigner (NE JAMAIS committer le .env réel) :
MAXITYRE_USERNAME=
MAXITYRE_PASSWORD=
# Durée de cache du catalogue, en secondes. 1800 (30 min) = valeur par
# défaut du code. Plus la valeur est haute, plus le stock et les prix
# affichés peuvent être périmés : à 7200 (2 h), un pneu montré disponible
# peut être refusé à l'ajout au panier. Le checkout revalide toujours les
# prix en direct, mais l'écart se voit côté client.
MAXITYRE_CACHE_TTL=1800
# Garde-fou anti-boucle (100 pages x 20 = 2000 pneus max par dimension)
MAXITYRE_MAX_PAGES=100

# === Recherche par plaque (SIV) ===
# Inscription gratuite (100 req/jour) : https://www.apiplaqueimmatriculation.com
# Coller ici le JETON du tableau de bord (transmis au provider sous le
# nom `token`). Sans lui, la recherche par plaque retombe sur Midas —
# voir Admin > Réglages.
SIV_API_KEY=
# URL de l'API (changer uniquement si vous utilisez un autre provider) :
SIV_API_URL=https://api.apiplaqueimmatriculation.com/plaque

# === Paiement ===
# "simulated" = dev (aucun contrat). "sogecommerce" = paiement reel.
PAYMENT_PROVIDER=simulated
# Back Office Sogecommerce -> Parametrage -> Cles d'API REST.
# Cles de TEST : le mot de passe API commence par 'testpassword_'.
# Passage en prod = remplacer par les cles de production (rien d'autre).
SOGECOMMERCE_SHOP_ID=
SOGECOMMERCE_API_PASSWORD=
# Cle HMAC-SHA256 (2e cle, sert a verifier la signature des IPN) :
SOGECOMMERCE_HMAC_KEY=
# URL publique que Sogecommerce appelle pour notifier le paiement.
# En local + test : utiliser un tunnel (ngrok) car la banque doit
# pouvoir joindre cette URL depuis l'exterieur.
SOGECOMMERCE_IPN_URL=https://tousvospneus.com/payment/ipn

# ── Mentions legales de l'emetteur (facture PDF) ────────────────
# OBLIGATOIRES sur une facture de SAS assujettie a la TVA
# (art. L441-9 code de commerce, art. 242 nonies A ann. II CGI).
# A recopier depuis le Kbis : ces valeurs ne sont volontairement PAS
# pre-remplies, une facture avec un faux SIRET serait un faux document.
# Toute ligne laissee vide est simplement omise de la facture.
# ── Mentions legales de l'emetteur (facture PDF) ────────────────
COMPANY_LEGAL_NAME=TOUSVOSPNEUS.COM
COMPANY_ADDRESS=35 bis chemin des Beaumouilles
COMPANY_CITY=13710 FUVEAU
COMPANY_SIRET=97767196500019
# TVA intracom. deduite du SIREN (cle = (12 + 3 x SIREN mod 97) mod 97).
# A confirmer contre l'attribution recue des impots avant mise en prod.
COMPANY_VAT_NUMBER=FR38977671965
# Manquants, obligatoires sur une facture de SAS :
COMPANY_CAPITAL= 500€
COMPANY_RCS= Aix-en-Provence B 977 671 965

# ── Jobs planifies (crontab) ────────────────────────────────────
# Jeton partage entre le crontab du VPS et l'API. Tant qu'il est vide,
# TOUS les endpoints /cron/* repondent 503 : relances de paiement,
# rappels de rendez-vous et alertes de retard sont donc inactifs.
# Generer avec :  openssl rand -hex 32
CRON_TOKEN=
#
# Crontab a poser sur le VPS :
#   # Relance des commandes non payees, toutes les heures
#   0  * * * * curl -sS -X POST -H "X-Cron-Token: $CRON_TOKEN" \
#       https://tousvospneus.com/api/cron/dunning >/dev/null
#   # Rappels de RDV de montage (J-1) + alertes « pneus pas expedies »
#   15 * * * * curl -sS -X POST -H "X-Cron-Token: $CRON_TOKEN" \
#       https://tousvospneus.com/api/cron/appointments >/dev/null

# ── Tests de bout en bout ───────────────────────────────────────
# Catalogue deterministe pour les e2e : stock illimite, aucun appel
# reseau. Les tests tapaient le vrai catalogue Maxityre, dont le stock
# s'epuise — la suite virait au rouge d'un run a l'autre sans qu'aucun
# code n'ait change. NE JAMAIS poser en production : les marques
# renvoyees sont fictives.
#   docker compose up -d api   (avec SUPPLIER_PROVIDER=fake dans .env)
#   cd web && npx playwright test
# SUPPLIER_PROVIDER=fake
